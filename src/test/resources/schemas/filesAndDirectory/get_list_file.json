{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Get Files",
  "type": "object",
  "properties": {
    "limit": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "modified": {
            "type": "string",
            "format": "date-time"
          },
          "size": {
            "type": "integer"
          },
          "mime_type": {
            "type": "string"
          },
          "md5": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "preview": {
            "type": "string"
          },
          "public_key": {
            "type": "string"
          },
          "public_url": {
            "type": "string"
          },
          "_embedded": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              },
              "offset": {
                "type": "integer"
              },
              "path": {
                "type": "string"
              },
              "sort": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {}
                }
              }
            },
            "required": [
              "total",
              "limit",
              "offset",
              "path",
              "sort",
              "items"
            ]
          },
          "media_type": {
            "type": "string",
            "enum": [
              "audio",
              "backup",
              "book",
              "compressed",
              "data",
              "development",
              "diskimage",
              "document",
              "encoded",
              "executable",
              "flash",
              "font",
              "image",
              "settings",
              "spreadsheet",
              "text",
              "unknown",
              "video",
              "web"
            ]
          },
          "file": {
            "type": "string"
          },
          "resource_id": {
            "type": "string"
          },
          "share": {
            "type": "object",
            "properties": {
              "is_owned": {
                "type": "boolean"
              },
              "is_root": {
                "type": "boolean"
              },
              "rights": {
                "type": "string"
              }
            },
            "required": [
              "is_owned",
              "is_root",
              "rights"
            ]
          },
          "revision": {
            "type": "integer"
          },
          "comment_ids": {
            "type": "object",
            "properties": {
              "public_resource": {
                "type": "string"
              },
              "private_resource": {
                "type": "string"
              }
            },
            "required": [
              "public_resource",
              "private_resource"
            ]
          },
          "custom_properties": {
            "type": "object",
            "properties": {}
          },
          "exif": {
            "type": "object",
            "properties": {
              "date_time": {
                "type": "string",
                "format": "date-time"
              },
              "gps_latitude": {
                "type": "object",
                "properties": {}
              },
              "gps_longitude": {
                "type": "object",
                "properties": {}
              }
            }
          },
          "antivirus_status": {
            "type": "string"
          },
          "photoslice_time": {
            "type": "string",
            "format": "date-time"
          },
          "sizes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "name"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "path",
          "type",
          "name",
          "created",
          "modified",
          "size",
          "mime_type",
          "md5",
          "sha256",
          "media_type",
          "file",
          "resource_id",
          "revision",
          "comment_ids",
          "exif",
          "antivirus_status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "limit",
    "offset",
    "items"
  ],
  "additionalProperties": false
}